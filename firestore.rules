rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentEmail() {
      return signedIn() ? request.auth.token.email : null;
    }

    function hasUidProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function uidRole() {
      return hasUidProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function hasLegacyProfile() {
      return signedIn()
        && currentEmail() != null
        && exists(/databases/$(database)/documents/users/$(currentEmail()));
    }

    function legacyRole() {
      return hasLegacyProfile()
        ? get(/databases/$(database)/documents/users/$(currentEmail())).data.role
        : null;
    }

    function isAdmin() {
      return signedIn() && (uidRole() == 'admin' || legacyRole() == 'admin');
    }

    function isInstructor() {
      return signedIn() && uidRole() == 'instructor';
    }

    function isStaff() {
      return isAdmin() || isInstructor();
    }

    function ownsUserDocument(userId) {
      return signedIn() && (
        userId == request.auth.uid
        || resource.data.email == currentEmail()
      );
    }

    match /users/{userId} {
      allow read: if isAdmin() || ownsUserDocument(userId);

      allow create: if isAdmin() || (
        signedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == currentEmail()
        && request.resource.data.role == 'member'
      );

      allow update: if isAdmin() || (
        ownsUserDocument(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
      );

      allow delete: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /studios/{studioId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isStaff() || (signedIn() && resource.data.status == 'published');
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isStaff() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
