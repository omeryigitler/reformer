{
  "name": "reformer-pilates-malta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "check": "npm run build",
    "firebase:deploy:rules": "npx firebase-tools deploy --only firestore:rules --project reformer-pilates-malta",
    "firebase:deploy:functions": "npx firebase-tools deploy --only functions --project reformer-pilates-malta"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
